# Every value the application reads. Copy to .env.local for a local run; never commit real values.

# ---- ports -----------------------------------------------------------------
# PORT is the one port a browser opens (the Vite client in development, the
# gateway in production). The services take free ports and are told where the
# others are by scripts/dev-all.mjs.
PORT=4000
VITE_PORT=5173
AUTH_PORT=4001
ROOMS_PORT=4002
BOOKINGS_PORT=4003
# A service also accepts SERVICE_PORT, which wins over the per-service port when
# the platform gives one (a container, or a preview that assigns ports itself).
# SERVICE_PORT=

# ---- where the services are ------------------------------------------------
# Read by the gateway and by the services that ask each other for data. Leave
# them out and the local defaults above are used; set them where the parts run
# on different hosts.
# AUTH_URL=http://127.0.0.1:4001
# ROOMS_URL=http://127.0.0.1:4002
# BOOKINGS_URL=http://127.0.0.1:4003

# ---- database --------------------------------------------------------------
# Local development and `npm test` only. The deployed services are given a real,
# internet-reachable connection string (MongoDB Atlas or any host that is not
# this computer). Never a loopback address in a deployed service.
MONGODB_URI=mongodb://127.0.0.1:27017/examplehotel
# The unit tests' database. Its name must end in _test: the helper refuses
# anything else before it clears a collection.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/examplehotel_test
# The end-to-end runner's own database: the journeys create and change bookings,
# so they run against a database of their own and never the hotel's.
E2E_MONGODB_URI=mongodb://127.0.0.1:27017/examplehotel_e2e

# ---- sessions --------------------------------------------------------------
# Signs the httpOnly session cookie, and the token the services use between
# themselves on /internal routes. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Read on the server only. Never a VITE_ variable, never committed.
SESSION_SECRET=

# ---- the application -------------------------------------------------------
# NODE_ENV=production turns on secure cookies and the TLS-aware cookie settings.
NODE_ENV=development
# The hotel's own name, used in the subject lines and headings of the emails it
# sends. The public details guests read are kept in the database, on Hotel Details.
HOTEL_NAME=hotelIndoora
# The address the site is served on, with no trailing slash: https://your-hotel.example
# Every link the site puts in an email (the confirmation link, the staff invitation,
# the payment link) and the address PayPal returns a guest to are built from it, so a
# deployed site must set it. Left unset, links are relative and only work in a browser
# on the same origin.
# SITE_URL=
# Frames the pages may be shown inside. Left unset, framing is refused outright.
# Set it to the exact origin that embeds the site, for example https://example.com
# FRAME_ANCESTORS=

# ---- the build (client) ----------------------------------------------------
# The sample accounts and the review panel on Sign In are there to walk the product,
# not to sign a guest in. A build made for a real hotel sets this to off, and the
# sign-in page is then the form, the way to Create Account and the messages only.
# A plain `npm run build`, the local preview and the recorded visual baselines keep
# them, because the variable is unset here.
# VITE_SAMPLE_ACCOUNTS=off

# ---- payments (PayPal) -----------------------------------------------------
# PayPal is the only payment channel. Sandbox first; live credentials are added
# by the hotel when the site is ready to take real money.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set once the webhook is registered in the PayPal dashboard; notifications are
# still verified with PayPal before any booking, payment or refund changes.
PAYPAL_WEBHOOK_ID=

# ---- email ----------------------------------------------------------------
# One transactional email service delivers the confirmation link, booking
# confirmations, change and cancellation notices, PayPal payment links and
# staff invitations. Read on the server only.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
MAIL_FROM=stay@hotelindoora.com

# ---- room type photographs -------------------------------------------------
# Room type photographs live in one Supabase Storage bucket, read by guests
# through the bucket's public URL; MongoDB holds the object path. The
# service-role key is server code only - never in the browser, never in a VITE_
# variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ROOM_PHOTOS_BUCKET=room-type-photos

# ---- the first staff account (scripts/seed-production.mjs) ------------------
# The live site gets no demo accounts. This is the hotel's own first staff
# sign-in: the account is created as an invitation with no password at all, and
# the person named here sets their own password from the emailed link.
# STAFF_EMAIL=
# STAFF_NAME=
# The address the invitation link points at: the live site's own SITE_URL, set
# once in the application section above.

# ---- the checks this project runs (scripts/ and client/) -------------------
# Where the end-to-end, accessibility, performance and security checks point
# when they are told to use a running server.
# BASE_URL=http://127.0.0.1:4000
# The browser the performance and security checks drive, when it is not found
# automatically.
# CHROME_PATH=
# PW_CHROMIUM_EXECUTABLE=
# ZAP_PATH=
# Keep the server's own output while a check runs, for reading a failure.
# WITH_SERVER_LOG=1
# The ports scripts/dev-all.mjs and its siblings use, and where the ports they
# chose are written. The defaults are right for a local run.
# GATEWAY_PORT=4000
# INTERNAL_PORT_BASE=4100
# AGENTFORGE_PORTS_FILE=
# AGENTFORGE_PREVIEW_RUNTIME_ID=
